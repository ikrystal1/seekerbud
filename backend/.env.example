# ── Solana ────────────────────────────────────────────────────────────────────
SOLANA_RPC_URL=https://api.devnet.solana.com

# ── x402 payments ─────────────────────────────────────────────────────────────
# Payment mode: "prepaid" uses on-device agent wallet (Option 2 — no server key)
X402_MODE=prepaid

# Gateway: the x402-compatible LLM endpoint (leave blank to use built-in mock)
X402_GATEWAY_URL=

# Coinbase CDP facilitator (free tier: 1,000 tx/mo)
X402_FACILITATOR_URL=https://api.cdp.coinbase.com/platform/v2/x402

# Cost caps — fail closed if exceeded
X402_MAX_COST_PER_TURN=0.05
X402_MAX_COST_PER_DAY=1.00

# ── Server ────────────────────────────────────────────────────────────────────
# Railway sets PORT automatically — do not set manually on Railway
PORT=3000
LOG_LEVEL=info
NODE_ENV=production

# ── Optional security ─────────────────────────────────────────────────────────
# Set this and send X-App-Key header from mobile to lock the API to your app only
APP_KEY=

# ── Optional: Vercel KV (only needed for multi-instance rate limiting) ─────────
# Leave blank — in-memory rate limiting is fine for Railway single instance
KV_REST_API_URL=
KV_REST_API_TOKEN=
