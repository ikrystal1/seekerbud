{
  "name": "seekerbud-backend",
  "version": "0.1.0",
  "private": true,
  "description": "SeekerBud Node API — AI brain + chain reads + x402 payments (Vercel serverless)",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch server.ts",
    "start": "node dist/server.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "lint": "eslint \"lib/**/*.ts\" \"api/**/*.ts\" \"test/**/*.ts\" server.ts scripts/**/*.ts",
    "gen:key": "tsx scripts/gen-payer-key.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.98.4",
    "dotenv": "^17.4.2",
    "x402": "^1.2.0"
  },
  "devDependencies": {
    "@types/bs58": "^4.0.4",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "eslint": "^10.8.1",
    "tsx": "^4.23.11",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0"
  }
}
