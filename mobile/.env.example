# Backend
EXPO_PUBLIC_BACKEND_URL=https://your-deployed-backend.up.railway.app

# Must match the APP_KEY in the backend .env
EXPO_PUBLIC_APP_KEY=your-app-key

# x402 gateway / Solana mainnet RPC (ships in the app bundle)
EXPO_PUBLIC_HELIUS_API_KEY=your-helius-api-key
EXPO_PUBLIC_MAINNET_RPC=https://api.mainnet-beta.solana.com

# Wallet sign-in identity (domain used in SIWS/sign-in payloads)
EXPO_PUBLIC_APP_DOMAIN=seekerbud.app
