# SeekerBud Mobile — Environment Variables
# Copy to .env and fill in the values

# Backend API
EXPO_PUBLIC_BACKEND_URL=https://your-backend.railway.app
EXPO_PUBLIC_APP_KEY=

# Helius RPC (Solana mainnet — used for x402 payments + chain reads)
# Get your key at https://www.helius.dev
EXPO_PUBLIC_HELIUS_API_KEY=

# Fallback Solana mainnet RPC (used when Helius is unavailable)
EXPO_PUBLIC_MAINNET_RPC=https://api.mainnet-beta.solana.com

# App identity (for MWA)
EXPO_PUBLIC_APP_DOMAIN=seekerbud.app
